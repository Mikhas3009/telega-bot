{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@app/errors": ["../../packages/errors/src"],
      "@app/errors/*": ["../../packages/errors/src/*"],
      "@app/config": ["../../packages/config/src"],
      "@app/config/*": ["../../packages/config/src/*"],
      "@app/logger": ["../../packages/logger/src"],
      "@app/logger/*": ["../../packages/logger/src/*"],
      "@app/contracts": ["../../packages/contracts/src"],
      "@app/contracts/*": ["../../packages/contracts/src/*"],
      "@app/messaging": ["../../packages/messaging/src"],
      "@app/messaging/*": ["../../packages/messaging/src/*"],
      "@app/testing": ["../../packages/testing/src"],
      "@app/testing/*": ["../../packages/testing/src/*"],
      "producer-service/*": ["apps/producer-service/src/*"],
      "consumer-service/*": ["apps/consumer-service/src/*"],
      "notification-service/*": ["apps/notification-service/src/*"]
    }
  },
  "include": ["vitest.config.ts", "test/**/*"]
}
