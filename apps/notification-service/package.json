{
  "name": "notification-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "lint": "eslint src test --max-warnings 0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/errors": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/messaging": "workspace:*",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/terminus": "^10.2.3",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "opossum": "^8.4.0",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^6.20.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@app/testing": "workspace:*",
    "@nestjs/testing": "^10.4.5",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.7.36",
    "@testcontainers/rabbitmq": "^10.13.2",
    "@testcontainers/redis": "^10.13.2",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/opossum": "^8.1.8",
    "@types/uuid": "^10.0.0",
    "amqplib": "^0.10.4",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.2"
  }
}
