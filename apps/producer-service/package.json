{
  "name": "producer-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings 0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/errors": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/messaging": "workspace:*",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@app/testing": "workspace:*",
    "@nestjs/testing": "^10.4.5",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@testcontainers/rabbitmq": "^10.13.2",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "amqplib": "^0.10.4",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.2"
  }
}
